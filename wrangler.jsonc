{
  "name": "ai-browser-agent",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "previews": {
    "browser": {
      "binding": "BROWSER"
    }
  },
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "preview_urls": true
}
