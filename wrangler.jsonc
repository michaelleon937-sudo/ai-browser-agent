{
  "name": "ai-browser-agent",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "previews": {
    "browser": {
      "binding": "BROWSER"
    },
    "vars": {
      "SENTRY_DSN": "https://47e0b1a4805c45a64665bd46b1f0990b@o4512361266937856.ingest.us.sentry.io/4512361789128705",
      "SENTRY_ENVIRONMENT": "preview"
    }
  },
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "preview_urls": true
}
