# AI Browser Agent — environment variable template
# Copy to .env and fill values. NEVER commit real secrets.

NODE_ENV=development
PORT=8080
DATA_DIR=./data
CONTROL_TOKEN=

# Payment mode: mock (default) | sandbox | live
PAYMENT_MODE=mock
LIVE_PAYMENTS_ENABLED=false

# Stripe TEST only when PAYMENT_MODE=sandbox (never sk_live_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa SANDBOX only when PAYMENT_MODE=sandbox
MPESA_API_URL=https://sandbox.safaricom.co.ke
# Daraja Consumer Key / Secret (sandbox only)
MPESA_CONSUMER_KEY=
MPESA_CLIENT_ID=
MPESA_CLIENT_SECRET=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BUSINESS_ID=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_PHONE_NUMBER=
