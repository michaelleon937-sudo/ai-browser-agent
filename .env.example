# Copy to .env and fill in values. Never commit real secrets.

# Control plane
CONTROL_TOKEN=
CONTROL_BROWSER_ALLOWLIST=example.com,github.com,wikipedia.org,tavily.com

# Database
DATABASE_PATH=./data/agent.db

# AI
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments (sandbox / mock only)
PAYMENT_MODE=mock
LIVE_PAYMENTS_ENABLED=false

# Stripe TEST only when PAYMENT_MODE=sandbox (never sk_live_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa SANDBOX only when PAYMENT_MODE=sandbox
MPESA_API_URL=https://sandbox.safaricom.co.ke
# Daraja Consumer Key / Secret (sandbox only)
MPESA_CONSUMER_KEY=
MPESA_CLIENT_ID=
MPESA_CLIENT_SECRET=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BUSINESS_ID=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_PHONE_NUMBER=

# Phase 8 production Daraja is abstracted and DISABLED.
# LIVE_PAYMENTS_ENABLED must remain false. No live STK/charge/refund.
# Do not put real consumer key/secret/passkey in this file.

# Stakaba Tanzania (sandbox only until explicit live approval)
# API key from https://app.stakaba.com/ → Settings → API Keys (sk_test_...)
STAKABA_ENV=sandbox
STAKABA_API_KEY=
STAKABA_MERCHANT_ID=
STAKABA_API_BASE_URL=https://api.stakaba.com
# Optional: webhook URL registered in Stakaba dashboard
# STAKABA_CALLBACK_URL=https://ai-browser-agent-8qig.onrender.com/api/payments/stakaba/callback

# Phase A1 — SMTP for controlled client delivery (optional; send fails safely when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
