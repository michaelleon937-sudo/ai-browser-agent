# Copy to .env and fill in values. Never commit real secrets.

# Control plane
CONTROL_TOKEN=
CONTROL_BROWSER_ALLOWLIST=example.com,github.com,wikipedia.org,tavily.com

# Database
DATABASE_PATH=./data/agent.db

# AI
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments (sandbox / mock only)
PAYMENT_MODE=mock
LIVE_PAYMENTS_ENABLED=false

# Phase 8 sandbox payment integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa SANDBOX
MPESA_API_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CLIENT_ID=
MPESA_CLIENT_SECRET=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BUSINESS_ID=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_PHONE_NUMBER=

# Phase 8 production Daraja is abstracted and DISABLED.
# LIVE_PAYMENTS_ENABLED must remain false. No live STK/charge/refund.

# Stakaba Tanzania (sandbox only until explicit live approval)
STAKABA_ENV=sandbox
STAKABA_API_KEY=
STAKABA_MERCHANT_ID=
STAKABA_BASE_URL=https://api.stakaba.com

# Phase A1/A2 — CloudMailin controlled customer delivery
CLOUDMAILIN_OUTBOUND_ACCOUNT_ID=
CLOUDMAILIN_OUTBOUND_API_TOKEN=
CLOUDMAILIN_OUTBOUND_FROM=
CLOUDMAILIN_OUTBOUND_EVENTS_AUTH_SECRET=
CLOUDMAILIN_OUTBOUND_TEST_MODE=false
CLOUDMAILIN_API_BASE_URL=https://api.cloudmailin.com/api/v0.1

# Legacy SMTP transport is for internal notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=

# Phase A2 — CloudMailin-only inbound email
# CloudMailin uses Authorization: Bearer <server-secret>. Never commit the real value.
CLOUDMAILIN_WEBHOOK_AUTH_SECRET=
# Existing inbound route retained for the already-configured CloudMailin callback:
# https://ai-browser-agent-8qig.onrender.com/api/inbound/email/resend.json
# CloudMailin outbound delivery-events webhook:
# https://ai-browser-agent-8qig.onrender.com/api/outbound/email/cloudmailin/events

# Creative rendering providers — all optional.
# Secrets must be configured only in the deployment secret store, never committed.
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai
SHOTSTACK_API_KEY=
SHOTSTACK_API_BASE_URL=https://api.shotstack.io/edit/v1

# Free/local/self-hosted rendering
CREATIVE_RENDERER_STRATEGY=free-first
CREATIVE_OUTPUT_DIR=/data
CREATIVE_FPS=24
FFMPEG_BIN=ffmpeg
COMFYUI_BASE_URL=
COMFYUI_TIMEOUT_MS=600000
COMFYUI_POLL_MS=1000
BLENDER_BIN=

# Self-hosted 3D render worker (optional)
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=
RENDER_WORKER_PORT=8090
RENDER_OUTPUT_DIR=/data/renders
